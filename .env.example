# ------------------------------------------------------------------
# Nexa — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to version control.
# ------------------------------------------------------------------

# -- LLM Providers (at least one required for live inference) ------
# Gemini Flash — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# -- Streamlit UI Security (optional) -----------------------------
# Set this to enable a passkey gate on the Streamlit UI.
# Leave blank to run in open mode.
APP_PASSWORD=

# -- FastAPI REST Security (optional) -----------------------------
# Protect REST API endpoints with X-API-Key header authentication.
# Leave blank to run in open/dev mode.
NEXA_API_KEY=

# -- Webhooks (optional) -------------------------------------------
# Post conflict alerts and user-flagged answers to a Slack/Discord webhook.
# Example: https://hooks.slack.com/services/T00/B00/xxxx
NEXA_WEBHOOK_URL=

# -- CORS (optional — for nexa-api container) ---------------------
# Comma-separated list of allowed origins for the FastAPI REST server.
# Defaults to localhost:8501 and localhost:3000.
NEXA_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000
